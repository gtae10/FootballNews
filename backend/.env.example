# Copy this file to `.env` and adjust values as needed.
# These defaults match docker-compose.yml.

# --- MySQL (used by docker-compose.yml) ---
DB_NAME=liverpool_news
DB_PORT=3306
DB_PASSWORD=changeme

# --- Spring Boot datasource (used by application.yml) ---
DB_URL=jdbc:mysql://localhost:3306/liverpool_news
DB_USERNAME=root
# DB_PASSWORD is shared with the docker-compose MySQL root password above

# --- Google OAuth2 login ---
# Google Cloud Console > APIs & Services > Credentials 에서 OAuth 클라이언트를 만들고,
# 승인된 리디렉션 URI에 http://localhost:8080/login/oauth2/code/google 를 등록하세요.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- JWT / 프론트엔드 연동 ---
# 최소 32바이트 이상의 임의 문자열로 교체하세요 (예: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_VALIDITY_MINUTES=10080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
