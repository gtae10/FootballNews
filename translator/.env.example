# Copy this file to `.env` and adjust values as needed.

# --- DB 연결 (SQLAlchemy URL) ---
# backend/docker-compose.yml로 띄운 로컬 MySQL을 그대로 사용한다면 기본값을 바꾸지 않아도 됩니다.
TRANSLATOR_DB_URL=mysql+pymysql://root:password@localhost:3306/liverpool_news

# --- Anthropic API (선택) ---
# 기본 번역 엔진은 Argos Translate(오프라인, 무료)라 이 키가 없어도 동작한다.
# translate.py의 ENGINE을 "anthropic"으로 바꿔 Claude 엔진을 쓸 때만 필요하다.
# 코드에 하드코딩하지 않고 반드시 환경 변수로 주입한다.
ANTHROPIC_API_KEY=your-anthropic-api-key
